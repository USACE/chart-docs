        <mxCell id="wy6kk0VNfTqs-kZn-FKX-17" parent="wy6kk0VNfTqs-kZn-FKX-7" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=8;" value="&lt;b&gt;Hazard Tools&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Allows the user to &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 102));&quot;&gt;create OR import&lt;/font&gt; all data that define hazard conditionals for the risk model. Data is also validated at this step.&lt;/div&gt;" vertex="1">
