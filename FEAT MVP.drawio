        <mxCell id="mv93WEUP_g8FL77KGjty-35" parent="mv93WEUP_g8FL77KGjty-34" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;div&gt;&amp;nbsp;Modular and extensible portal to ingest and generate modeling input data.&lt;/div&gt;&lt;div&gt;The layer of abstraction must allow future implementations of data ingestion&lt;/div&gt;&lt;div&gt;avenues. Modeling input data can come from –&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1.&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;Algorithmic Application Programming Interfaces (API),&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2.&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;Generated through a workflow native to the UI,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;3.&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;User upload&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="430" x="10" y="40" as="geometry" />
        </mxCell>
        <mxCell id="mv93WEUP_g8FL77KGjty-36" parent="mv93WEUP_g8FL77KGjty-30" style="swimlane;whiteSpace=wrap;html=1;rounded=1;" value="Modeling" vertex="1">
          <mxGeometry height="210" width="360" x="500" y="40" as="geometry" />
        </mxCell>
        <mxCell id="mv93WEUP_g8FL77KGjty-37" parent="mv93WEUP_g8FL77KGjty-36" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;div&gt;&lt;div&gt;Modular and extensible portal to configure&lt;/div&gt;&lt;div&gt;and operationalize the modeling modules.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1.&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;Modeling modules should integrate into the scalable&lt;/div&gt;&lt;div&gt;computing framework established with the infrastructure work&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="350" x="10" y="60" as="geometry" />
        </mxCell>
        <mxCell id="mv93WEUP_g8FL77KGjty-38" parent="mv93WEUP_g8FL77KGjty-30" style="swimlane;whiteSpace=wrap;html=1;rounded=1;" value="Data Review" vertex="1">
          <mxGeometry height="200" width="380" x="910" y="40" as="geometry" />
        </mxCell>
        <mxCell id="mv93WEUP_g8FL77KGjty-39" parent="mv93WEUP_g8FL77KGjty-38" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;div&gt;&lt;div&gt;&lt;div&gt;Analytical portal that summarizes data and provide&lt;/div&gt;&lt;div&gt;data transparency to all stages of the modeling.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1.&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;All modeling input and output data should be downloadable&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2.&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;The data review portal should summarize information for study&amp;nbsp;&lt;/div&gt;&lt;div&gt;relevant analyses in similar fashion to the CHART Scoping Tool.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="390" x="10" y="45" as="geometry" />
        </mxCell>
