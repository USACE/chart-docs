        </mxCell>
        <mxCell id="wy6kk0VNfTqs-kZn-FKX-21" parent="wy6kk0VNfTqs-kZn-FKX-7" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=8;" value="&lt;b&gt;Coastal System Response (CSR) Tools&lt;/b&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Allows the user to&amp;nbsp;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 102));&quot;&gt;create OR import&lt;/font&gt;&amp;nbsp;all data that define the CSR.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="135" x="35" y="240" as="geometry" />
        </mxCell>
        <mxCell id="wy6kk0VNfTqs-kZn-FKX-24" parent="wy6kk0VNfTqs-kZn-FKX-7" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=8;" value="&lt;b&gt;Exposure &amp;amp; Vulnerability Tools&lt;/b&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Allows the user to&amp;nbsp;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 102));&quot;&gt;create, import OR export&lt;/font&gt;&amp;nbsp;all data that define the exposure (assets within the storm impact zone) and vulnerability of that exposure.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="135" x="209.99999999999994" y="300" as="geometry" />
        </mxCell>
        <mxCell id="wy6kk0VNfTqs-kZn-FKX-27" parent="wy6kk0VNfTqs-kZn-FKX-7" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=8;" value="&lt;b&gt;Plan Alternative Tools&lt;/b&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Allows the user to&amp;nbsp;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 102));&quot;&gt;create, import OR export&lt;/font&gt;&amp;nbsp;plan alternatives. This defines what factors (adjustment targets) will change (e.g. first floor elevation)&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="135" x="380" y="260" as="geometry" />
        </mxCell>
